[sub_resource type="Shader" id="Shader_pole_no_bg"]
code = "shader_type canvas_item;

void fragment() {
    vec4 c = texture(TEXTURE, UV);
    float max_channel = max(max(c.r, c.g), c.b);
    float min_channel = min(min(c.r, c.g), c.b);
    float saturation = max_channel - min_channel;
    float luminance = dot(c.rgb, vec3(0.299, 0.587, 0.114));

    // Remove both the white and the classic light-gray checker/background dots.
    if (saturation < 0.14 && luminance > 0.38) {
        discard;
    }

    COLOR = c;
}"

